# EmailJS credentials for the contact form.
# These are public by design (they ship to the browser), but keeping them in
# env vars means they can be rotated without a code change.
# Values live in the EmailJS dashboard: https://dashboard.emailjs.com
#
# Copy to .env.local and fill in. The template expects the form fields
# user_name, user_email, user_number, subject and message — do not rename them.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
